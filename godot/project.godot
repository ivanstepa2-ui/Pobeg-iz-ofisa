; Engine configuration file.
; Godot 4.3+ (GL Compatibility — максимальная совместимость с Android).

config_version=5

[application]

config/name="Побег из офиса"
config/description="Стелс-экшен в стиле PS1: Александр Вадимович Дзвиник сбегает из бесконечного офиса."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[display]

; HUD — в логическом 854x480 (чёткий текст). 3D-мир рендерится в SubViewport высотой 240 строк
; и растягивается без фильтрации (см. scripts/game/game.gd). На 20:9 ширина растягивается (expand).
window/size/viewport_width=854
window/size/viewport_height=480
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_2d=0
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
; Освещение по вершинам (Гуро) — как на PS1.
shading/overrides/force_vertex_shading=true
shading/overrides/force_lambert_over_burley=true
environment/defaults/default_clear_color=Color(0.03, 0.035, 0.045, 1)
